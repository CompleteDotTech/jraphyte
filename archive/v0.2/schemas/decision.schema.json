{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.2:decision",
  "title": "TRACE-GC decision 0.2-design",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2-design"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "question_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "question_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "requested_version": {
          "type": "string",
          "minLength": 1
        },
        "returned_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "enum": [
            "MATCHED",
            "MISMATCHED",
            "UNVERIFIED",
            "SYNTHETIC"
          ]
        }
      },
      "required": [
        "provider",
        "requested_version",
        "returned_version",
        "verification"
      ],
      "additionalProperties": false
    },
    "execution_mode": {
      "enum": [
        "SYNTHETIC",
        "RECORDED",
        "LIVE"
      ]
    },
    "status": {
      "enum": [
        "OK",
        "ERROR"
      ]
    },
    "primitive": {
      "enum": [
        "CHOICE",
        "NOUL",
        "SCORE"
      ]
    },
    "raw_answer": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "choice"
                },
                "choice": {
                  "type": "string",
                  "minLength": 1
                },
                "probabilities": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "type",
                "choice",
                "probabilities",
                "confidence"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "noul"
                },
                "noul": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "type",
                "noul"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "score"
                },
                "score": {
                  "type": "number",
                  "minimum": 0
                },
                "legend": {
                  "type": "object",
                  "minProperties": 2,
                  "maxProperties": 10,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "probabilities": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "type",
                "score",
                "legend",
                "probabilities",
                "confidence"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "probability_distribution": {
      "anyOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_confidence": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "semantic_outcome": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome_derivation": {
      "enum": [
        "RAW_CHOICE",
        "BINARY_PROPOSITION",
        "NOT_DERIVED",
        "OPERATIONAL_FAILURE"
      ]
    },
    "confidence_band": {
      "enum": [
        "UNQUALIFIED",
        "LOW",
        "MEDIUM",
        "HIGH",
        "STRONG_NO",
        "LIKELY_NO",
        "UNCERTAIN",
        "LIKELY_YES",
        "STRONG_YES"
      ]
    },
    "calibration_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_score": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "POLICY_SCORE",
                "RANKING_SCORE",
                "RESOLVER_SCORE"
              ]
            },
            "value": {
              "type": "number"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "resolver_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_result": {
      "enum": [
        "NOT_EVALUATED",
        "ACCEPT",
        "REJECT",
        "ABSTAIN",
        "RETRIEVE_MORE_EVIDENCE",
        "HUMAN_REVIEW",
        "CONFLICT_UNRESOLVED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "latency_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_usd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_request_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_decision_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "abstention_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "candidate_id",
    "candidate_hash",
    "pack_id",
    "question_id",
    "question_schema_version",
    "question_hash",
    "state_hash",
    "request_hash",
    "evidence_refs",
    "model",
    "execution_mode",
    "status",
    "primitive",
    "raw_answer",
    "probability_distribution",
    "raw_confidence",
    "semantic_outcome",
    "outcome_derivation",
    "confidence_band",
    "calibration_ref",
    "policy_score",
    "policy_version",
    "resolver_version",
    "policy_result",
    "created_at",
    "latency_ms",
    "cost_usd",
    "provider_request_id",
    "parent_decision_refs",
    "supersedes",
    "abstention_reason",
    "error"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "primitive": {
            "const": "NOUL"
          }
        }
      },
      "then": {
        "properties": {
          "raw_confidence": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "properties": {
          "raw_answer": {
            "type": "null"
          },
          "probability_distribution": {
            "type": "null"
          },
          "raw_confidence": {
            "type": "null"
          },
          "semantic_outcome": {
            "type": "null"
          },
          "error": {
            "type": "string",
            "minLength": 1
          },
          "outcome_derivation": {
            "const": "OPERATIONAL_FAILURE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "OK"
          }
        }
      },
      "then": {
        "properties": {
          "raw_answer": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "choice"
                  },
                  "choice": {
                    "type": "string",
                    "minLength": 1
                  },
                  "probabilities": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "type",
                  "choice",
                  "probabilities",
                  "confidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "noul"
                  },
                  "noul": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "type",
                  "noul"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "score"
                  },
                  "score": {
                    "type": "number",
                    "minimum": 0
                  },
                  "legend": {
                    "type": "object",
                    "minProperties": 2,
                    "maxProperties": 10,
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "probabilities": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "type",
                  "score",
                  "legend",
                  "probabilities",
                  "confidence"
                ],
                "additionalProperties": false
              }
            ]
          },
          "probability_distribution": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "error": {
            "type": "null"
          }
        }
      }
    }
  ]
}
