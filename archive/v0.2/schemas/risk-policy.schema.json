{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.2:risk-policy",
  "title": "TRACE-GC risk-policy 0.2-design",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2-design"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "ANALYSIS_ONLY",
        "QUALIFIED"
      ]
    },
    "expected_model_version": {
      "type": "string",
      "minLength": 1
    },
    "question_program_version": {
      "type": "string",
      "minLength": 1
    },
    "calibration_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "allow_synthetic_accepted_writes": {
      "const": false
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk_class": {
            "enum": [
              "R0",
              "R1",
              "R2",
              "R3",
              "R4",
              "R5"
            ]
          },
          "automatic": {
            "type": "boolean"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "calibration_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "fallback": {
            "enum": [
              "ABSTAIN",
              "HUMAN_REVIEW",
              "ANALYSIS",
              "QUARANTINE_ONLY"
            ]
          }
        },
        "required": [
          "risk_class",
          "automatic",
          "threshold",
          "calibration_ref",
          "fallback"
        ],
        "additionalProperties": false
      },
      "minItems": 6
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "mode",
    "expected_model_version",
    "question_program_version",
    "calibration_ref",
    "allow_synthetic_accepted_writes",
    "rules"
  ],
  "additionalProperties": false
}
