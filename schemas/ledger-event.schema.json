{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.2:ledger-event",
  "title": "TRACE-GC ledger-event 0.2-design",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2-design"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "enum": [
        "SOURCE",
        "CANDIDATE",
        "EVIDENCE",
        "PACK",
        "DECISION",
        "RESOLUTION",
        "PLAN",
        "TRANSACTION",
        "RESEARCH"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_mode": {
      "enum": [
        "SYNTHETIC",
        "RECORDED",
        "LIVE"
      ]
    },
    "parent_event_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "previous_event_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "sequence",
    "stage",
    "created_at",
    "execution_mode",
    "parent_event_refs",
    "previous_event_hash",
    "payload_refs",
    "payload_hash",
    "event_hash"
  ],
  "additionalProperties": false
}
