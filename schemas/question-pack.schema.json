{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.2:question-pack",
  "title": "TRACE-GC question-pack 0.2-design",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2-design"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "closure_id": {
      "type": "string",
      "minLength": 1
    },
    "closure_complete": {
      "type": "boolean"
    },
    "closure_requirement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "candidate_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "state": {
      "type": "object"
    },
    "state_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "question_program_version": {
      "type": "string",
      "minLength": 1
    },
    "packing_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "security_scope": {
      "type": "string",
      "minLength": 1
    },
    "graph_snapshot_version": {
      "type": "integer",
      "minimum": 0
    },
    "schema_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "question_schema_version": {
            "type": "string",
            "minLength": 1
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "primitive": {
            "enum": [
              "CHOICE",
              "NOUL",
              "SCORE"
            ]
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "label",
                "description"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          },
          "depends_on_question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "prior_decision_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "question_id",
          "question_schema_version",
          "candidate_id",
          "primitive",
          "instructions",
          "criteria",
          "depends_on_question_ids",
          "prior_decision_refs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "primitive": {
                  "const": "CHOICE"
                }
              }
            },
            "then": {
              "properties": {
                "criteria": {
                  "maxItems": 255
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "primitive": {
                  "const": "SCORE"
                }
              }
            },
            "then": {
              "properties": {
                "criteria": {
                  "maxItems": 10
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "primitive": {
                  "const": "NOUL"
                }
              }
            },
            "then": {
              "properties": {
                "criteria": {
                  "maxItems": 2
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "token_accounting": {
      "type": "object",
      "properties": {
        "basis": {
          "enum": [
            "SYNTHETIC_FIXTURE",
            "VERIFIED_ESTIMATOR",
            "UNVERIFIED_ESTIMATOR"
          ]
        },
        "estimator_version": {
          "type": "string",
          "minLength": 1
        },
        "state_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "question_tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "request_cap": {
          "type": "integer",
          "minimum": 1
        },
        "state_longest_cap": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "basis",
        "estimator_version",
        "state_tokens",
        "question_tokens",
        "request_cap",
        "state_longest_cap"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "billing_receipt_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_basis": {
          "enum": [
            "NOT_MEASURED",
            "PROVIDER_USAGE_ESTIMATE",
            "VERIFIED_BILLING"
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "latency_ms",
        "cost_usd",
        "billing_receipt_ref",
        "cost_basis"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "run_id",
    "closure_id",
    "closure_complete",
    "closure_requirement_refs",
    "evidence_refs",
    "candidate_refs",
    "state",
    "state_hash",
    "request_hash",
    "question_program_version",
    "packing_policy_version",
    "model_version",
    "security_scope",
    "graph_snapshot_version",
    "schema_hash",
    "questions",
    "token_accounting",
    "usage"
  ],
  "additionalProperties": false
}
