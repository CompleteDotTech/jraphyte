{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.3.0:paper-pilot-phase-import",
  "title": "TRACE-GC paper-pilot-phase-import v0.3.0",
  "type": "object",
  "properties": {
    "version": {
      "const": "paper-pilot-phase-authorization-v1"
    },
    "operation": {
      "const": "PHASE_IMPORT"
    },
    "capsule_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_implementation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "operation",
    "capsule_sha256",
    "target_implementation_sha256",
    "run_id"
  ],
  "additionalProperties": false
}
