{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "representation_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "document_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "source_id",
    "source_version",
    "representation_id",
    "text",
    "document_hash",
    "active"
  ],
  "additionalProperties": false
}
