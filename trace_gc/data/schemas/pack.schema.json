{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.3.0:pack",
  "title": "TRACE-GC pack v0.3.0",
  "type": "object",
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_mode": {
      "enum": [
        "SYNTHETIC",
        "RECORDED",
        "LIVE"
      ]
    },
    "security_scope": {
      "type": "string",
      "minLength": 1
    },
    "graph_version": {
      "type": "integer",
      "minimum": 0
    },
    "schema_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "program_version": {
      "type": "string",
      "minLength": 1
    },
    "materializer_version": {
      "enum": [
        "materializer-v1",
        "materializer-v1+graph-v1"
      ]
    },
    "packing_version": {
      "anyOf": [
        {
          "const": "complete-closure-v1"
        },
        {
          "type": "string",
          "pattern": "^minimum-source-graph-v1:[0-9a-f]{64}$"
        }
      ]
    },
    "tokenizer_version": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "prior_observation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "enum": [
              "SUPPORT",
              "IDENTITY",
              "EVIDENCE_QUALITY",
              "GRAPH_RELEVANCE"
            ]
          },
          "primitive": {
            "enum": [
              "CHOICE",
              "NOUL",
              "SCORE"
            ]
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "description"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "run_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pack_id": {
                  "type": "string",
                  "minLength": 1
                },
                "question_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "run_id",
                "pack_id",
                "question_id"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "context_item_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "candidate_id",
          "task",
          "primitive",
          "instructions",
          "criteria",
          "depends_on"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "state": {
      "type": "object"
    },
    "closure": {
      "type": "object",
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "source_snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "prior_observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "graph_version": {
              "type": "integer",
              "minimum": 0
            },
            "schema_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "graph_version",
            "schema_hash"
          ],
          "additionalProperties": false
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "roots",
        "record_ids",
        "edges",
        "evidence_ids",
        "source_snapshot_ids",
        "prior_observation_ids",
        "snapshot",
        "omissions",
        "hash"
      ],
      "additionalProperties": false
    },
    "materialization": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "record_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "transformation": {
            "enum": [
              "identity-v1",
              "collapse-whitespace-v1"
            ]
          }
        },
        "required": [
          "path",
          "record_id",
          "record_hash",
          "locator",
          "transformation"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "transformation": {
      "enum": [
        "identity-v1",
        "collapse-whitespace-v1"
      ]
    },
    "semantic_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "wire_request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cache_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_base64": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "budget": {
      "type": "object",
      "properties": {
        "state_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "question_tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "request_cap": {
          "type": "integer",
          "minimum": 1
        },
        "state_longest_cap": {
          "type": "integer",
          "minimum": 1
        },
        "measured": {
          "type": "boolean"
        }
      },
      "required": [
        "state_tokens",
        "question_tokens",
        "request_cap",
        "state_longest_cap",
        "measured"
      ],
      "additionalProperties": false
    },
    "graph_retrieval_query_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "graph_context_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_retrieval_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_closure_id": {
      "type": "string",
      "minLength": 1
    },
    "retrieval_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "snapshot_id",
    "run_id",
    "execution_mode",
    "security_scope",
    "graph_version",
    "schema_hash",
    "model_version",
    "program_version",
    "materializer_version",
    "packing_version",
    "tokenizer_version",
    "candidate_ids",
    "prior_observation_ids",
    "questions",
    "state",
    "closure",
    "materialization",
    "transformation",
    "semantic_hash",
    "wire_request_hash",
    "cache_key",
    "request_base64",
    "created_at",
    "budget"
  ],
  "additionalProperties": false
}
