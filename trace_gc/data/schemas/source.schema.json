{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.3.0:source",
  "title": "TRACE-GC source v0.3.0",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "representation": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "text_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "security_scope": {
      "type": "string",
      "minLength": 1
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "raw_document_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "image_evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "page_lineage": {
      "type": "object",
      "properties": {
        "version": {
          "const": "reviewed-native-pdf-page-v1"
        },
        "raw_document_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "physical_page": {
          "type": "integer",
          "minimum": 1
        },
        "render_dpi": {
          "const": 144
        },
        "page_png_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "native_text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_kind": {
          "enum": [
            "assistant",
            "human"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "checks": {
          "type": "object",
          "properties": {
            "source_identity": {
              "const": true
            },
            "reading_order": {
              "const": true
            },
            "boundaries": {
              "const": true
            },
            "notation": {
              "const": true
            }
          },
          "required": [
            "source_identity",
            "reading_order",
            "boundaries",
            "notation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "raw_document_sha256",
        "physical_page",
        "render_dpi",
        "page_png_sha256",
        "native_text_sha256",
        "start",
        "end",
        "reviewer",
        "reviewer_kind",
        "reviewed_at",
        "checks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "source_id",
    "version",
    "representation",
    "text",
    "text_hash",
    "security_scope",
    "parser_version",
    "raw_document_hash"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "representation": {
            "const": "reviewed-image-transcription-v1"
          }
        }
      },
      "then": {
        "required": [
          "image_evidence_id"
        ]
      },
      "else": {
        "not": {
          "required": [
            "image_evidence_id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "representation": {
            "const": "reviewed-native-pdf-page-v1"
          }
        }
      },
      "then": {
        "required": [
          "page_lineage"
        ]
      },
      "else": {
        "not": {
          "required": [
            "page_lineage"
          ]
        }
      }
    }
  ]
}
